# v0.1 仅启用 Bocha + AnySearch；Tavily 在 v0.2a 启用
BOCHA_API_KEY=your_bocha_key_here
ANYSEARCH_API_KEY=your_anysearch_key_here

# LLM 旧配置（legacy，Provider Registry 未配置时生效）
LLM_PRIMARY_BASE_URL=https://api.provider1.com/v1
LLM_PRIMARY_API_KEY=sk-xxx
LLM_FALLBACK_BASE_URL=https://api.provider2.com/v1
LLM_FALLBACK_API_KEY=sk-yyy

# 轻模型：意图分类 / Query 构造（Stage 2，WP3+；DeepSeek 直连可改 base url 为 https://api.deepseek.com/v1）
LLM_LIGHT_MODEL=deepseek-chat
# Stage 2 意图分类超时（默认 [P-04]=500ms；冒烟验收可临时调大）
LLM_CLASSIFY_TIMEOUT_MS=500

# 视觉模型（OpenAI 兼容协议；image 输入为 data URL）
VLM_BASE_URL=https://api.provider1.com/v1
VLM_API_KEY=sk-xxx
VLM_MODEL=gpt-4o-mini
VLM_TIMEOUT_MS=8000

# Provider Registry（E104，OpenSquilla 借鉴）：便宜优先 + fallback 链
# 顺序默认 deepseek,minimax,zhipu；只有配置了 key 的 provider 才参与。
LLM_PROVIDER_ORDER=deepseek,minimax,zhipu
DEEPSEEK_API_KEY=sk-xxx
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_LIGHT_MODEL=deepseek-chat
DEEPSEEK_MEDIUM_MODEL=deepseek-chat
DEEPSEEK_HEAVY_MODEL=deepseek-chat
DEEPSEEK_VISION_MODEL=deepseek-chat
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.chat/v1
MINIMAX_LIGHT_MODEL=MiniMax-M2.7
MINIMAX_MEDIUM_MODEL=MiniMax-M2.7
MINIMAX_HEAVY_MODEL=MiniMax-M3
MINIMAX_VISION_MODEL=MiniMax-M2.7
ZHIPU_API_KEY=
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_LIGHT_MODEL=glm-5-turbo
ZHIPU_MEDIUM_MODEL=glm-5.2
ZHIPU_HEAVY_MODEL=glm-5.3
ZHIPU_VISION_MODEL=glm-5.2
LLM_MEDIUM_TIMEOUT_MS=30000

# 本地日历 SQLite 路径（可选，calendar-skill）
CALENDAR_DB_PATH=./data/calendar.db
QUOTES_DB_PATH=./data/quotes.db
MESSAGES_DB_PATH=./data/messages.db

# 可选：本地 SQLite 数据目录，默认项目根目录
DATA_DIR=./data

# GitHub/Gitee 联动（§11.4）：token 仅本次进程使用，不落盘
GITHUB_USER=chuangxiaohui-cloud
GITHUB_TOKEN=
GITEE_USER=cxv138
GITEE_TOKEN=
